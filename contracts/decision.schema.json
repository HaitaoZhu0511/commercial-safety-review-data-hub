{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commercial-safety/decision.schema.json",
  "title": "Commercial Safety Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "case_id", "actor", "outcome", "reason_codes", "evidence_ids", "policy_versions", "decided_at"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["rule", "model_orchestrator", "reviewer", "expert", "appeal_reviewer"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "outcome": { "enum": ["approve", "reject", "request_change", "restrict", "age_gate", "escalate", "no_decision"] },
    "severity": { "enum": ["none", "low", "medium", "high", "critical"] },
    "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "policy_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "rule_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "model_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes_ref": { "type": "string" },
    "supersedes_decision_id": { "type": "string" },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
