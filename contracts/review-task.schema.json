{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commercial-safety/review-task.schema.json",
  "title": "Commercial Safety Review Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "case_id", "project_id", "queue_id", "review_level", "priority", "status", "content_scope", "created_at", "sla_due_at"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "queue_id": { "type": "string", "minLength": 1 },
    "review_level": { "enum": ["initial", "second", "expert", "appeal", "quality_sample"] },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "status": { "enum": ["queued", "assigned", "reviewing", "waiting_evidence", "completed", "cancelled", "expired"] },
    "assignee_id": { "type": "string" },
    "required_skill_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "content_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_ids", "region", "content_types"],
      "properties": {
        "snapshot_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "region": { "type": "string" },
        "content_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "industry_id": { "type": "string" }
      }
    },
    "candidate_policy_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "assigned_at": { "type": "string", "format": "date-time" },
    "sla_due_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
