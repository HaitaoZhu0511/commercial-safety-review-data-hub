{
  "schema_version": "1.0",
  "status": "template",
  "initial_state": "submitted",
  "terminal_states": ["closed", "cancelled"],
  "states": [
    "submitted",
    "snapshot_ready",
    "signals_ready",
    "policy_evaluated",
    "auto_approved",
    "auto_rejected",
    "queued",
    "assigned",
    "reviewing",
    "second_review",
    "expert_review",
    "decided",
    "enforced",
    "monitored",
    "appealed",
    "appeal_review",
    "upheld",
    "overturned",
    "remanded",
    "closed",
    "cancelled"
  ],
  "transitions": [
    { "from": "submitted", "to": "snapshot_ready", "event": "snapshot_created" },
    { "from": "snapshot_ready", "to": "signals_ready", "event": "required_signals_completed" },
    { "from": "signals_ready", "to": "policy_evaluated", "event": "policy_evaluation_completed" },
    { "from": "policy_evaluated", "to": "auto_approved", "event": "low_risk_auto_decision" },
    { "from": "policy_evaluated", "to": "auto_rejected", "event": "deterministic_violation_auto_decision" },
    { "from": "policy_evaluated", "to": "queued", "event": "manual_review_required" },
    { "from": "queued", "to": "assigned", "event": "task_assigned" },
    { "from": "assigned", "to": "reviewing", "event": "review_started" },
    { "from": "reviewing", "to": "second_review", "event": "second_review_required" },
    { "from": "reviewing", "to": "expert_review", "event": "expertise_required" },
    { "from": "reviewing", "to": "decided", "event": "review_submitted" },
    { "from": "second_review", "to": "decided", "event": "second_review_submitted" },
    { "from": "expert_review", "to": "decided", "event": "expert_review_submitted" },
    { "from": "auto_approved", "to": "enforced", "event": "decision_applied" },
    { "from": "auto_rejected", "to": "enforced", "event": "decision_applied" },
    { "from": "decided", "to": "enforced", "event": "decision_applied" },
    { "from": "enforced", "to": "monitored", "event": "post_delivery_monitoring_started" },
    { "from": "enforced", "to": "appealed", "event": "appeal_submitted" },
    { "from": "monitored", "to": "appealed", "event": "appeal_submitted" },
    { "from": "appealed", "to": "appeal_review", "event": "appeal_assigned" },
    { "from": "appeal_review", "to": "upheld", "event": "original_decision_upheld" },
    { "from": "appeal_review", "to": "overturned", "event": "original_decision_overturned" },
    { "from": "appeal_review", "to": "remanded", "event": "case_remanded" },
    { "from": "remanded", "to": "queued", "event": "new_review_task_created" },
    { "from": "upheld", "to": "closed", "event": "appeal_closed" },
    { "from": "overturned", "to": "closed", "event": "corrective_action_completed" },
    { "from": "monitored", "to": "closed", "event": "maturity_window_completed" }
  ]
}
